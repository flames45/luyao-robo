# ========================================
#  Robo - 路遥  配置文件模板
#  复制为 .env 后填入你的 key 即可使用
# ========================================

# ----- 必填：DeepSeek API Key -----
# 获取地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_URL=https://api.deepseek.com/chat/completions

# ----- 服务器 -----
LINGSHU_HOST=127.0.0.1
LINGSHU_PORT=8002
# 公网部署必须保持 1；0 仅用于本机硬件/人设管理。
LINGSHU_PUBLIC_MODE=1
LINGSHU_DATA_DIR=./web_data
# 使用自备服务器和 compose.yaml 时填写，不带 https://。
# SITE_DOMAIN=robo.example.com

# ----- 语音（二选一）-----
# Fish Speech（推荐，国内低延迟）https://fish.audio
# FISH_SPEECH_API_KEY=sk-your-fish-key-here
# FISH_SPEECH_VOICE=nova
# Edge TTS（免费，无需 key）
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural

# ----- Live2D 桌宠（装了 Live2DViewerEX 的话）-----
# LINGSHU_PET_ENABLE=1
# LINGSHU_PET_PORT=8001
# LIVE2D_EXAPI_URL=ws://127.0.0.1:10086/api
# LIVE2D_MODEL_ID=0

# ----- 以下保持默认即可 -----
LINGSHU_WORKERS=4
MEMPALACE_WING=robo_memory
MEMPALACE_TOP_K=5
LINGSHU_AUTO_SYNC_TURNS=5
LINGSHU_HISTORY_MAX_KB=500
LINGSHU_ALLOW_MODEL_TOOLS=1
LINGSHU_ALLOW_RISKY_TOOLS=0
